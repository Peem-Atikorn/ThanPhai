# Copy to .env and fill in. Never commit .env.
# Details for every key: docs/API_REQUIREMENTS.md
# Keep comments on their own lines: Docker Compose reads "KEY=   # comment" as the value "# comment".

# --- Database ---
POSTGRES_USER=thanphai
POSTGRES_PASSWORD=

# --- Hazard data ---
# TMD public demo pair; register your own at https://data.tmd.go.th
TMD_UID=api
TMD_UKEY=api12345
# Required for the NWP forecast (module 06)
TMD_NWP_TOKEN=
THAIWATER_BASE_URL=https://api-v3.thaiwater.net/api/v1/thaiwater30/public
# Optional; empty = keyless 24h file
FIRMS_MAP_KEY=
# Flood extent and hotspots
GISTDA_API_KEY=
# Routes to shelters (openrouteservice by HeiGIT; key from https://account.heigit.org). Empty = no route button result.
ORS_API_KEY=
# Shelter routes a visitor may ask for per minute (0 = no limit)
ROUTE_LIMIT_PER_MINUTE=6
# NASA Earthdata Login user token for NDVI (MODIS MOD13Q1) and other NASA data.
# Create at https://urs.earthdata.nasa.gov -> Generate Token. Valid 60 days, max 2 at a time; regenerate before it expires.
EARTHDATA_TOKEN=

# --- Map ---
NEXT_PUBLIC_SPHERE_KEY=
LONGDO_API_KEY=
NOMINATIM_USER_AGENT=ThanPhai/0.1 (contact: team email)
# RainViewer radar on the map (free tier: personal/educational only). "internal" = team machines and demos; anything else = off.
RADAR_LAYER=off

# --- AI (Gemini) ---
# Answers stay rule-based when GEMINI_API_KEY is empty. Get a key at https://aistudio.google.com/apikey
# Free tier: requests may be used by Google to improve products; paid tier: not used.
# qwen = Qwen (thanphai-qwen on Ollama) first; when it is off, fails or its answer is rejected, Gemini answers
# if GEMINI_API_KEY is set (LLM_FALLBACK=none: Qwen only). gemini = Gemini only.
LLM_PROVIDER=qwen
LLM_FALLBACK=gemini
QWEN_MODEL=thanphai-qwen
QWEN_ENDPOINT=http://host.docker.internal:11434
QWEN_TIMEOUT_MS=8000
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=LOW
GEMINI_API_KEY=

# --- Public site (Cloudflare Tunnel) ---
# docker compose --profile public up -d. Token from Cloudflare Zero Trust > Networks > Tunnels (keep it secret).
CLOUDFLARE_TUNNEL_TOKEN=
# Questions per visitor per minute on /v1/ask (0 = no limit).
ASK_LIMIT_PER_MINUTE=10
# 0.0.0.0 opens the web port on the LAN (phone testing); default 127.0.0.1.
WEB_BIND=127.0.0.1
EMBEDDING_MODEL=BAAI/bge-m3

# --- Notifications ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
